# ============================================================================
# config.fragment — Kernel Config Fragment for ZYBO Audio (linux-xlnx 6.6 LTS)
# ============================================================================
# Applied on top of xilinx_zynq_defconfig (linux-xlnx 6.6 LTS, 与 Vivado 2024.1 配套).
# 用法（CI/手工）：make xilinx_zynq_defconfig && scripts/kconfig/merge_config.sh -m .config <本文件> && make olddefconfig
# 架构依据见项目 docs/RESEARCH.md（PL330 + adi,axi-i2s + ssm2602 + simple-audio-card）

# ─── Sound / ALSA ───────────────────────────────────────────────────────────
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_I2C_AND_SPI=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_DEBUG=y
CONFIG_SND_PCM_XRUN_DEBUG=y

# ─── ASoC simple-audio-card（纯 DT 声卡）───────────────────────────────────
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y

# ─── CPU DAI：ADI AXI-I2S（PL330 模式；Digilent axi_i2s_adi 寄存器兼容）─────
CONFIG_SND_SOC_ADI=y
CONFIG_SND_SOC_ADI_AXI_I2S=y

# ─── Codec：SSM2603（走 ssm2602 驱动）──────────────────────────────────────
CONFIG_SND_SOC_SSM2602=y
CONFIG_SND_SOC_SSM2602_I2C=y

# ─── DMA：Zynq 内置 PL330（本设计采用；不使用 Xilinx AXI DMA）──────────────
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
# 备选路线（AXI DMA + audio formatter，需 BD 增加对应 IP）：
# CONFIG_XILINX_DMA=y
# CONFIG_XILINX_DMA_ENGINE=y
# CONFIG_AXI_DMAC=y
# CONFIG_SND_SOC_XILINX_AUDIO_FORMATTER=y

# ─── I2C（AXI IIC 控制器）──────────────────────────────────────────────────
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_XILINX=y
CONFIG_I2C_CADENCE=y

# ─── GPIO ───────────────────────────────────────────────────────────────────
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_XILINX=y
CONFIG_GPIO_ZYNQ=y
CONFIG_GPIO_GENERIC_PLATFORM=y

# ─── SPI ────────────────────────────────────────────────────────────────────
CONFIG_SPI=y
CONFIG_SPI_XILINX=y
CONFIG_SPI_CADENCE=y

# ─── USB & Networking ──────────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_ULPI=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ─── Filesystems ────────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FUSE_FS=y

# ─── UIO（Phase-3 DSP 寄存器访问的可选通道）────────────────────────────────
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

# ─── 发行版用户空间（Debian armhf + systemd）────────────────────────────────
# xilinx_zynq_defconfig 是嵌入式取向：cgroup 控制器、命名空间、fanotify、
# tmpfs POSIX ACL 全都没开。Buildroot 最小系统用不到，但接了 Debian 之后
# systemd 会严重降级（服务隔离/资源控制失效、大量 unit 报错）。
# 实测缺失清单见项目 docs/TROUBLESHOOTING.md §14。
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ─── 音频工具链便利项 ───────────────────────────────────────────────────────
# /proc/config.gz：上板核对内核配置（本次 bring-up 就是靠它查的）
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ─── USB WiFi：发布版默认支持常见 dongle（2026-09-10）────────────────────────
# 背景：xilinx_zynq_defconfig 里**整个无线栈都没开**（CFG80211/MAC80211/RFKILL 全无），
#       staging 的 r8188eu 在 6.6 已被删除 ⇒ 全部走主线驱动。
# 原则：**按"常见型号都能用"来配**，不是只支持手上这一个。
#   覆盖（括号内为主线驱动）：
#     RTL8188EU/CU、RTL8192CU/EU、RTL8188FU、RTL8723BU、RTL8188GU   → rtl8xxxu
#     RTL8821CU、RTL8723DU、RTL8822BU/CU                            → rtw88 (USB)
#     MT7601U（最常见的廉价 150M）                                   → mt7601u
#     MT7610U / MT7612U / MT7921AU                                  → mt76 (x0u/x2u/7921u)
#     RT5370 / RT3070 / RT2070 等                                    → rt2800usb
#     AR9271（如 TP-Link TL-WN722N v1）                              → ath9k_htc
#   ⚠️ **不覆盖**：RTL8811AU/8812AU/8814AU/8821AU 等 AC 双频 dongle —— 它们
#      **不在 Linux 主线**，需第三方 out-of-tree 驱动，发布镜像不含（README 里说明）。
# 固件与用户态（Debian 侧）：firmware-realtek / firmware-mediatek / firmware-atheros /
#   firmware-misc-nonfree(rt2870.bin) + wpasupplicant + iw + rfkill + wireless-regdb。
# 依赖已核实：LEDS_CLASS / USB / CRYPTO / CRC32 均已是 y。
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
# ── Realtek
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
# ⚠️ RTW88 外面套了一层 menuconfig：不写 CONFIG_RTW88=y 的话，
#    下面那堆 CONFIG_RTW88_* 会被 olddefconfig **静默丢弃**（实测踩过：
#    RTW88_CORE/USB/芯片选项全没进 .config，而构建照样"成功"）。
CONFIG_RTW88=y
CONFIG_RTW88_CORE=y
CONFIG_RTW88_USB=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
# ── MediaTek
CONFIG_MT7601U=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x02_LIB=y
CONFIG_MT76x02_USB=y
CONFIG_MT76x0U=y
CONFIG_MT76x2U=y
CONFIG_MT792x_LIB=y
CONFIG_MT792x_USB=y
CONFIG_MT7921U=y
# ── Ralink
CONFIG_RT2X00=y
CONFIG_RT2X00_LIB_USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
# ── Atheros
CONFIG_ATH9K_HW=y
CONFIG_ATH9K_COMMON=y
CONFIG_ATH9K_HTC=y
